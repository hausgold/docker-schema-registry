#!/usr/bin/env bash

# Any non-zero exit code will break
set -e

# We need regular dnf to install EPEL
microdnf install -y dnf

# Install the EPEL software repository
EPEL='https://dl.fedoraproject.org/pub/epel'
dnf install -y \
  "${EPEL}/epel-release-latest-9.noarch.rpm"

microdnf install -y supervisor hostname dbus avahi nss-mdns
microdnf clean all
